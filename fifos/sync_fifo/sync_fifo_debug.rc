; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 0 25 2194 487 449 152

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / "" "/nfs/home/yecongrong/FAMSEV2/famsev2/fifos/sync_fifo/build/wave.fsdb"

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
windowTimeUnit 10000ps

; waveform viewport range
zoom 0.000000 38.885000 10000p
cursor 20.500000
marker 13.500000

; user define markers
; userMarker time_pos marker_name color linestyle
; visible top row signal index
top 1
; marker line index
markerPos 24

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


addGroup "G1"
activeDirFile "" "/nfs/home/yecongrong/FAMSEV2/famsev2/fifos/sync_fifo/build/wave.fsdb"
addSignal -h 15 /sync_fifo_tb/dut/clk
